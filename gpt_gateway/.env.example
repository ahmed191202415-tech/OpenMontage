# Custom GPT Action authentication.
GPT_GATEWAY_API_KEY=replace-me-with-a-long-random-secret

# Public HTTPS URL of this gateway (no trailing slash).
GPT_GATEWAY_PUBLIC_BASE_URL=https://your-openmontage-domain.example.com

# Used for expiring local render links when S3-compatible storage is not configured.
GPT_GATEWAY_SIGNING_SECRET=replace-me-with-a-different-long-random-secret

# Async execution and uploads.
GPT_GATEWAY_MAX_WORKERS=2
GPT_GATEWAY_MAX_UPLOAD_MB=200

# Optional persistent S3-compatible render storage.
# Standard AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY variables are used by boto3.
GPT_GATEWAY_S3_BUCKET=
GPT_GATEWAY_S3_REGION=auto
GPT_GATEWAY_S3_ENDPOINT_URL=
GPT_GATEWAY_S3_PREFIX=openmontage

# Provider keys for Veo, fal, Replicate, OpenAI, ElevenLabs, etc. remain in the root .env.
